# Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Database: local Postgres on Contabo/VPS or docker-compose
DATABASE_URL=postgresql+psycopg://crm_user:crm_password@localhost:5432/merea_crm

# Excel adapter paths, used for import/export or Excel-as-source mode
EXCEL_DATA_PATH=./data/crm-data.xlsx
EXCEL_BACKUP_DIR=./data/backups

# n8n webhook protection
N8N_WEBHOOK_TOKEN=change-me

# External services
PROPSTACK_API_KEY=
PROPSTACK_BASE_URL=https://api.propstack.de

